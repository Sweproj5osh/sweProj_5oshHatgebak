# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign and verify the system's own HMAC tokens (any long random string).
TOKEN_SECRET=replace-with-a-long-random-string

# PostgreSQL connection string (ADR-21). Required: the tests run only against PostgreSQL, never on in-memory storage.
# For the tests it names a role that may create databases (docs/setup/database.md).
POSTGRES_URL=

# Port the HTTPS entry point listens on. The server never answers plain HTTP.
PORT=3000

# The server's TLS certificate and private key, as PEM files (see docs/setup/https.md). Both are required.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Secret used to sign and verify the site entry and exit codes printed at each site (any long random string).
SITE_CODE_SECRET=replace-with-another-long-random-string

# The first Chair, created once at start-up when the audit log holds no bootstrap entry yet (names only; values are yours).
BOOTSTRAP_CHAIR_PHONE=
BOOTSTRAP_CHAIR_NAME=

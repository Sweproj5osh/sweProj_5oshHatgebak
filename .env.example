# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign and verify the system's own HMAC tokens (any long random string).
TOKEN_SECRET=replace-with-a-long-random-string

# PostgreSQL connection string. When unset, the server and the tests run on in-memory adapters.
DATABASE_URL=

# Port the HTTP entry point listens on.
PORT=3000

# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign and verify the system's own HMAC tokens (any long random string).
TOKEN_SECRET=replace-with-a-long-random-string

# PostgreSQL connection string. When unset, the server and the tests run on in-memory adapters.
DATABASE_URL=

# Port the HTTP entry point listens on.
PORT=3000

# Secret used to sign and verify the site entry and exit codes printed at each site (any long random string).
SITE_CODE_SECRET=replace-with-another-long-random-string

# The first Chair, created once at start-up when the audit log holds no bootstrap entry yet (names only; values are yours).
BOOTSTRAP_CHAIR_PHONE=
BOOTSTRAP_CHAIR_NAME=

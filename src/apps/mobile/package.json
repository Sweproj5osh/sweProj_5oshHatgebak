{
  "name": "@sayes/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The one app for every role (ADR-18): the first screen asks the role, the server decides everything else.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit -p .",
    "bundle": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-crypto": "~58.0.8",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0"
  }
}
